# Bug Hunting Framework Configuration

# Application
APP_NAME=BugHunter Framework
APP_VERSION=1.0.0
ENVIRONMENT=development

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend
FRONTEND_URL=http://localhost:3000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Database (optional - for future persistence)
DATABASE_URL=sqlite:///./bug_hunter.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=bug_hunter.log

# Scope & Safety
ENFORCE_SCOPE=true
ALLOW_LOCALHOST_TESTING=false

# Testing Limits
MAX_PAYLOADS_PER_TEST=10
REQUEST_TIMEOUT=30
MAX_CONCURRENT_TESTS=5

# Report Generation
REPORT_OUTPUT_DIR=./reports
REPORT_FORMAT=markdown

# Notifications (optional)
ENABLE_NOTIFICATIONS=false
WEBHOOK_URL=
